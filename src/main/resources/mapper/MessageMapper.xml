<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wanwan.springboot.mapper.MessageMapper">

    <select id="selectMessagePageByCondition" resultType="com.wanwan.springboot.pojo.po.Message">
        SELECT message.*,u.nickname as replyUserName
        from message
            LEFT JOIN user u on message.reply_user_id=u.id
        <where>
            <if test="nickName!='' and nickName!=null">
                message.nick_name LIKE CONCAT('%',#{nickName},'%')
            </if>
            <if test="enable==1">
                message.enable=1
            </if>
        </where>
        ORDER BY message.create_time DESC

    </select>
</mapper>
